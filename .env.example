# --- Database (Neon / Postgres) ---
DATABASE_URL="postgres://user:pass@host/db?sslmode=require"

# --- Latpeed(래피드) 결제 웹훅 ---
LATPEED_WEBHOOK_SECRET=""
ADMIN_ALERT_PHONE=""          # 결제취소 시 관리자 알림 받을 번호 (선택, 자동화 트리거 ON일 때)

# --- 토스페이먼츠 (docs/toss-payments-plan.md) ---
NEXT_PUBLIC_TOSS_CLIENT_KEY="" # 결제위젯용 클라이언트 키 (공개). 개발=테스트 키
TOSS_SECRET_KEY=""            # 승인 API Basic 인증용 시크릿 키 (서버 전용). 개발=테스트 키

# --- Solapi(솔라피) 문자 ---
SOLAPI_API_KEY=""
SOLAPI_API_SECRET=""
SOLAPI_SENDER=""              # 발신번호 (사전 등록·본인인증된 번호)
SOLAPI_KAKAO_PF_ID=""         # 알림톡 채널 pfId (선택, 알림톡 쓸 때)
SOLAPI_DRY_RUN=""             # "1" 이면 실제 발송 안 하고 로그만 (테스트용)

# --- 되는시간(WhatTime) ---
# 임베드 URL 은 캠페인 설정(bookingEmbedUrl)에서 관리. 아래는 웹훅/API 연동용(선택)
WHATTIME_WEBHOOK_SECRET=""    # 콜백 URL 에 ?token= 로 붙여 검증. 되는시간 설정 → Webhooks
WHATTIME_API_KEY=""           # GET /reservations 등 API 호출용 X-API-KEY (예약 목록 조회 시)

# --- VOD (P2: Mux 등 교체 예정, 지금은 단순 URL) ---
NEXT_PUBLIC_VOD_SRC=""

# --- 사이트 ---
NEXT_PUBLIC_SITE_URL=

# --- 사업자 정보 (푸터·개인정보처리방침. 기본값은 src/lib/business.ts, env 로 덮어씀) ---
NEXT_PUBLIC_BIZ_NAME=
NEXT_PUBLIC_BIZ_OWNER=
NEXT_PUBLIC_BIZ_REG_NO=
NEXT_PUBLIC_BIZ_ADDR=
NEXT_PUBLIC_BIZ_TEL=
NEXT_PUBLIC_BIZ_EMAIL=
NEXT_PUBLIC_BIZ_MAIL_ORDER_NO="http://localhost:3000"
VOD_ACCESS_WINDOW_HOURS=48

# --- Cron 보호 ---
CRON_SECRET=""
PRE_PAYMENT_NUDGE_HOURS=0.5     # 시청 시작 후 N시간 뒤 결제 유도 문자 (자동화 트리거 offsetHours 우선)

# --- 관리자 인증 (Clerk, Vercel 마켓플레이스가 자동 주입) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/admin/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/admin/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/admin
ADMIN_EMAILS=""               # 쉼표 구분 허용 이메일. 비우면 로그인한 누구나 관리자 (Clerk 대시보드에서 가입 제한 권장)

# --- Vercel Blob (관리자 이미지 업로드) ---
BLOB_READ_WRITE_TOKEN=""

# 래피드가 서명 대신 공유 토큰 방식이면: 헤더 X-Latpeed-Token 또는 ?token= 가 이 값과 일치
# (LATPEED_WEBHOOK_SECRET 를 그대로 사용)
